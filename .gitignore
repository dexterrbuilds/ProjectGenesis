# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo
!.env.example

/.local/

# Git hygiene: generated local research payloads stay on disk, not in source history.
# Reports, source, manifests and complete Brain Spec release packages remain trackable.
/research/**/*.npz
/research/**/*.npy
/research/**/*.RData
/research/**/*.mat
/research/**/*.xls
/research/**/*.xlsx
/research/**/*.zip
/research/**/*.bin
/research/**/*.gz
/research/**/sources/
/research/**/artifacts/**/circuit.json
/research/fly-boundary-study/anatomy/nodes.json
/research/fly-boundary-study/anatomy/selection.json
/research/fly-upwin-route-evidence/processed/*.json*
# Captured HTTP headers can contain temporary signed download credentials.
/research/**/*headers*

# Generated caches/logs; no source or canonical data is removed locally.
__pycache__/
*.pyc
*.pyo
*.log
/build/

# Verification reports/manifests remain versioned; raw logs/screenshots stay local.
/verification/**/*.txt
/verification/**/*.png
/verification/**/browser/

# Defense in depth for private preservation exports and local database copies.
/verification/**/PRIVATE*
/research/**/PRIVATE*
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
# These small, intentionally versioned releases must remain complete for verification.
!/research/genesis-brain-spec-v0.1/**
!/research/genesis-brain-spec-v0.2/**
