# WEB (Vercel): dormant by default. Absolute ISO timestamp with timezone; empty = unannounced.
# Launch: September 29, 2026 at midnight Pacific (PDT).
GENESIS_AWAKENS_AT=2026-09-29T00:00:00-07:00
GENESIS_PUBLIC_MODE=dormant
# LOCAL ONLY: unlock /preview and observation proxy when running npm run dev.
# Ignored by production builds, including Vercel Preview deployments.
GENESIS_DEV_PREVIEW=false
# Only needed for live observation / local preview. Omit entirely on dormant Vercel deployment.
# Never put database credentials or planner keys in the web environment.
GENESIS_API_URL=http://127.0.0.1:3001

# RUNTIME (Railway / Docker): external Postgres. Use provider-recommended TLS remotely.
DATABASE_URL=postgresql://genesis:genesis@127.0.0.1:5432/genesis
GENESIS_OPERATOR_TOKEN=
PORT=3001
HOST=0.0.0.0
GENESIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Legacy compatibility setting; ignored by dormant Runtime V1. No flag unlocks execution.
GENESIS_AUTONOMY_ENABLED=false
GENESIS_INTERVAL_MS=30000
GENESIS_MAX_DAILY_CYCLES=200
# Legacy fixture setting; Runtime V1 refuses empty databases and never initializes an organism.
GENESIS_STARTING_CENTS=10000
GENESIS_INTERNET=false
# Legacy configuration only. Runtime V1 starts no planner/provider; keys do not grant execution.
GENESIS_PLANNER_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=

# LOCAL ONLY. Optional localhost operator convenience; ignored in production.
GENESIS_DEV_OPERATOR=false
# Dedicated test database MUST be named genesis_runtime_v1_test. Disposable schemas only.
TEST_DATABASE_URL=

# Optional RUNTIME read-only SOL balance; supply all three or leave all empty.
# Observer worker disabled. Configuration is NOT an authorized wallet-identity binding. No private key is accepted.
SOLANA_RPC_URL=
SOLANA_WALLET_ADDRESS=
SOLANA_NETWORK=

# Pass 7 observation service only. See runtime/ENVIRONMENT.md; no implicit execution.
GENESIS_RUNTIME_MODE=dormant
GENESIS_EXPECTED_ORGANISM_ID=
GENESIS_EXPECTED_BIRTH=
GENESIS_DB_SCHEMA=public
GENESIS_DB_TLS=verify-full
# Optional private path to managed database CA certificate, never a client-side value.
GENESIS_DB_CA_FILE=
GENESIS_DB_POOL_MAX=4
GENESIS_DB_CONNECT_TIMEOUT_MS=5000
GENESIS_DB_STATEMENT_TIMEOUT_MS=15000
# PRIVATE tools receive separate credentials; never set these on Vercel/observer runtime.
GENESIS_MIGRATION_MODE=
GENESIS_MIGRATION_DATABASE_URL=
GENESIS_INSTALL_PLAN_FILE=
GENESIS_INSTALL_ACK=
GENESIS_DB_ROLES_FILE=
GENESIS_PRIVATE_OPERATOR_MODE=
GENESIS_OPERATOR_DATABASE_URL=
GENESIS_OPERATOR_AUTH_FILE=
GENESIS_OPERATOR_CREDENTIAL=
GENESIS_CONSUMER_MODE=
GENESIS_WORKER_DATABASE_URL=
